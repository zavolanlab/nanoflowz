/*
========================================================================================
    nanoflowz/nextflow.config
========================================================================================
*/

def myHome = System.getProperty("user.home")

params {
    // Pipeline Inputs
    tsv            = null

    // The master directory for this specific run
    rundir         = './run_01'
    
    // final outputs
    outdir         = "${params.rundir}/results"

    //nextflow working directory with intermediate files
    workdir_param        = "${params.rundir}/work"

    // path where to store installed conda environments
    conda_envs_dir = "${params.rundir}/conda_envs"
    
    // Tool Paths & References
    dorado         = "${myHome}/dorado-1.4.0-linux-x64/bin/dorado"
    model          = "${myHome}/nanoflowz/dna_r10.4.1_e8.2_400bps_sup@v5.2.0"
    polyA          = "${myHome}/materials/polya_config.toml"
    ref            = "/scicore/home/zavolan/GROUP/Genomes/homo_sapiens/Homo_sapiens.GRCh38.dna.primary_assembly.fa"
    reference_gtf  = "/scicore/home/zavolan/GROUP/Genomes/homo_sapiens/hg38_v42/gencode.v42.annotation.gtf"

    // Visualization
    num_reads      = 10  
    figwidth       = 15.0  
    figheight      = 3.2
    emit_circles   = false
}

// "workDir" is recognized by Nextflow
workDir = "${params.workdir_param}"

// -------------------------------------------------------------------------------------
//  PROFILES (Enable Conda execution securely)
// -------------------------------------------------------------------------------------
profiles {
    conda {
        conda.enabled = true
        // Environments will be built inside a dedicated folder within the run dir
        conda.cacheDir = "${params.conda_envs_dir}"
    }
}

// -------------------------------------------------------------------------------------
//  PROCESS RESOURCES & LABELS
// -------------------------------------------------------------------------------------
process {
    executor = 'slurm'
    
    // Base defaults
    cpus   = 1
    memory = '4 GB'
    time   = '20m'

    // Error handling for Out-Of-Memory (OOM) codes
    errorStrategy = { task.exitStatus in [137, 104, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    // --- 1. Compute Labels ---
    withLabel: process_single {
        cpus   = 1
        memory = '4 GB'
        time   = '20m'
    }
    
    withLabel: process_low {
        cpus   = 1
        memory = '8 GB'
        time   = '30m'
    }

    withLabel: process_medium {
        cpus   = 8
        memory = '32 GB'
        time   = '2h'
    }

    withLabel: process_high_memory {
        cpus   = 2
        // Dynamic memory scaling on retry
        memory = { 128.GB * task.attempt }
        time   = '2h'
    }

    withLabel: process_dynamic_memory {
        cpus   = 2
        memory = { 32.GB * task.attempt } 
        time   = { 2.h * task.attempt }
    }

    withLabel: process_gpu {
        queue          = 'h200'
        cpus           = 6
        memory         = '40 GB'
        time           = '2h'
        clusterOptions = '--gres=gpu:1 --qos=h200-1day'
    }

    // --- 2. Tool Environment Labels ---
    withLabel: env_samtools {
        conda = "${projectDir}/envs/samtools.yml"
    }
    withLabel: env_isoform {
        conda = "${projectDir}/envs/python_isoform.yml"
    }
    withLabel: env_pod5 {
        conda = "${projectDir}/envs/python_pod5.yml"
    }
    withLabel: env_plot {
        conda = "${projectDir}/envs/python_plot.yml"
    }
}
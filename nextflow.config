/*
========================================================================================
    nanoflowz/nextflow.config
========================================================================================
    Configuration file for the Nanoflowz pipeline.
    
    This config is optimized for NVIDIA GPU nodes (e.g., A100).
    It handles two-pass basecalling (Dorado) and signal visualization (Seaborn).
========================================================================================
*/

// Fetch user home to ensure paths are absolute and portable across different cluster nodes
def myHome = System.getProperty("user.home")

params {
    // ---------------------------------------------------------------------------------
    //  INPUT / OUTPUT DATA
    // ---------------------------------------------------------------------------------
    // tsv: Path to a tab-separated file with 'sample_id' and 'pod5' columns
    tsv        = null
    // outdir: Directory where all final BAMs, CSVs, and PDF plots will be saved
    outdir     = './results'

    // ---------------------------------------------------------------------------------
    //  SOFTWARE & ENVIRONMENT PATHS
    // ---------------------------------------------------------------------------------
    // dorado: Path to the Dorado basecaller executable
    dorado     = "${myHome}/dorado-1.3.1-linux-x64/bin/dorado"
    // condaEnv: Path to the pre-configured Conda environment for Python dependencies
    condaEnv   = "${myHome}/miniconda3/envs/nanopore"

    // ---------------------------------------------------------------------------------
    //  BIOLOGICAL REFERENCES & MODELS
    // ---------------------------------------------------------------------------------
    // model: The Dorado basecalling model (SUP is recommended for signal accuracy)
    model      = "${myHome}/nanoflowz/rna004_130bps_sup@v5.1.0"
    // polyA: Custom configuration file for Dorado's poly-A tail estimation
    polyA      = "${myHome}/materials/polya_config.toml"
    // ref: Genome FASTA used for alignment during basecalling
    ref        = "${myHome}/nanoflowz/GRCm38.primary_assembly.genome.fa"

    // ---------------------------------------------------------------------------------
    //  PIPELINE SETTINGS & VISUALIZATION
    // ---------------------------------------------------------------------------------
    // num_reads: Number of random read IDs to subsample per sample for plotting
    num_reads  = 10  
    // figwidth/figheight: Dimensions (inches) for the generated Nanopore signal plots
    figwidth   = 15.0  
    figheight  = 3.2
    // emit_circles: If false, hides the red circles marking base emissions to reduce
    emit_circles = false  
}

process {
    // Default executor for all processes (SLURM for HPC clusters)
    executor = 'slurm'
    
    // Use the specified Conda environment for Python-based tasks
    conda    = params.condaEnv
    
    // beforeScript: Ensures Conda is initialized and libraries are visible on worker nodes.
    // We export LD_LIBRARY_PATH to prevent shared library errors during GPU execution.
    beforeScript = """
        source ${myHome}/miniconda3/etc/profile.d/conda.sh
        export LD_LIBRARY_PATH=${myHome}/miniconda3/envs/nanopore/lib:\$LD_LIBRARY_PATH
    """

    // ---------------------------------------------------------------------------------
    //  RESOURCE ALLOCATION (CPU TASKS)
    //  Default settings for: extract_read_ids, filter_pod5, generate_signal_df
    // ---------------------------------------------------------------------------------
    cpus   = 1
    memory = '4 GB'
    time   = '20m'

    // ---------------------------------------------------------------------------------
    //  GPU RESOURCE OVERRIDES (DORADO TASKS)
    //  Dorado requires a GPU; settings below target a single A100 per job.
    // ---------------------------------------------------------------------------------
    withName: 'dorado_basecall|dorado_emit_moves' {
        queue          = 'a100'
        cpus           = 6
        memory         = '40 GB'
        time           = '29m'
        // --gres=gpu:1 is required to request the physical GPU hardware on SLURM
        clusterOptions = '--gres=gpu:1 --qos=a100-1day'
    }

    // ---------------------------------------------------------------------------------
    //  VISUALIZATION RESOURCES
    //  Seaborn plotting can be memory-intensive when rendering thousands of signal points.
    // ---------------------------------------------------------------------------------
    withName: visualize_signal {
        cpus   = 1
        memory = '8 GB' 
        time   = '15m'
    }
}

// -------------------------------------------------------------------------------------
//  CONDA CONFIGURATION
//  Enables automatic environment handling. CacheDir prevents re-downloading envs.
// -------------------------------------------------------------------------------------
conda {
    enabled = true
    cacheDir = "${myHome}/miniconda3/envs"
}